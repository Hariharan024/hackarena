# Get a free key at https://aistudio.google.com/apikey  (leave blank to run fully offline - Sakhi still works)
GEMINI_API_KEY=Your key
GEMINI_MODEL=gemini-3.8-flash
# Optional: Tamil voice from Gemini for devices without a Tamil browser voice. Set SAKHI_SERVER_TTS=off to disable.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
SAKHI_SERVER_TTS=on
# Extra allowed browser origins for local dev (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
